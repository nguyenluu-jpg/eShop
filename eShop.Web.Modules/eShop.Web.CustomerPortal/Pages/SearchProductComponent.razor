@if (products != null & products.Count() > 0)
{
    <div class="row">
        @foreach(var product in products)
        {
            <ProductCardComponent product="product"></ProductCardComponent>
        }
    </div>
}
else
{
    <text>No Products Found.</text>
}


@code {
    private IEnumerable<Product> products;     // Danh sách sản phẩm

    protected override void OnInitialized() // Khi mở trang, lấy tất cả sản phẩm
    {
        base.OnInitialized();
        products = searchProduct.Execute(""); 
    }

    // Khi bấm nút Search
    private void HandleSearch(string filter)
    {
        products = searchProduct.Execute(filter);
        // products = searchProduct.Execute(filter);
        // products = searchProduct.Execute("");
    }
}